class Solution {
    public int minimumDeletions(int[] nums) {
        int n = nums.length;
        int minIdx = 0;
        int maxIdx = 0;
        
        // Find the indices of the minimum and maximum elements
        for (int i = 0; i < n; i++) {
            if (nums[i] < nums[minIdx]) {
                minIdx = i;
            }
            if (nums[i] > nums[maxIdx]) {
                maxIdx = i;
            }
        }
        
        // Strategy 1: Remove both elements from the front
        int bothFront = Math.max(minIdx, maxIdx) + 1;
        
        // Strategy 2: Remove both elements from the back
        int bothBack = n - Math.min(minIdx, maxIdx);
        
        // Strategy 3: Remove one from the front and one from the back
        int frontAndBack = (Math.min(minIdx, maxIdx) + 1) + (n - Math.max(minIdx, maxIdx));
        
        // Return the minimum of all three strategies
        return Math.min(Math.min(bothFront, bothBack), frontAndBack);
    }
}
