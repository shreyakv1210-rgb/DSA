class Solution {
    public int kthSmallest(int[] arr, int k) {
        // Code here
        PriorityQueue<Integer> maxHeap = new PriorityQueue(Collections.reverseOrder());
            for(int num : arr){//use for loop for iterating array
                maxHeap.add(num);
                if(maxHeap.size()>k){
                    maxHeap.poll();// removes the largest one automatically
                }
                
            }
        return maxHeap.peek();//look at largest without changing it        }
    }
}
